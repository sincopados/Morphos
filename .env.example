# Cliente (llegan al navegador — no son secretos)
NUXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key moderna (sb_publishable_...), no la legacy anon JWT.
NUXT_PUBLIC_SUPABASE_KEY=sb_publishable_<...>

# Solo servidor. Esta llave IGNORA RLS en todas las tablas: nunca la
# prefijes con NUXT_PUBLIC_ ni la uses fuera de server/. Se obtiene en
# Project Settings -> API Keys -> service_role / secret.
# Usala solo para tareas internas de MORPHOS (activar jurisdicciones de
# compliance, soporte auditado). El onboarding NO la necesita: usa la
# funcion bootstrap_company(), que corre acotada dentro de la base.
NUXT_SUPABASE_SECRET_KEY=<secret-key>

# URL publica del sitio — i18n la necesita para generar los enlaces SEO
# (canonical y alternate) con dominio absoluto.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Pon en true SOLO despues de habilitar Google en el dashboard de Supabase
# (Authentication -> Sign In / Providers -> Google, con el client ID y secret
# de Google Cloud Console). Mientras este en false el boton no se muestra,
# porque sin el proveedor configurado Supabase manda a una pagina de error.
NUXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
