# Cliente (llegan al navegador — no son secretos)
NUXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=<anon-public-key>

# Solo servidor. Esta llave IGNORA RLS en todas las tablas: nunca la
# prefijes con NUXT_PUBLIC_ ni la uses fuera de server/. Se obtiene en
# Project Settings -> API Keys -> service_role.
# Usala solo para tareas internas de MORPHOS (activar jurisdicciones de
# compliance, soporte auditado). El onboarding NO la necesita: usa la
# funcion bootstrap_company(), que corre acotada dentro de la base.
SUPABASE_SERVICE_KEY=<service-role-key>
