# Supabase — https://supabase.com/dashboard/project/_/settings/api
NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=your-anon-public-key

# Clave `service_role`. Solo se usa en el servidor (server/api/**), nunca llega
# al navegador. Sin ella el Dashboard Global no puede CREAR usuarios: el resto
# de la aplicación funciona igual.
SUPABASE_SERVICE_KEY=your-service-role-key
